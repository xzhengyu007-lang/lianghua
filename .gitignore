.venv/
__pycache__/
*.py[cod]
.pytest_cache/
# pytest sometimes resolves its basetemp relative to the working directory; those
# trees must never be committed (246 such files slipped in once -- see 23.115).
pytest-of-*/
pytest-*/
data/cache/
data/cache_rawcheck/
data/cache_probe/
data/cache_ext/
reports/runs/
.DS_Store

# scratch space: one-off agent scripts, run logs and generated research output
.tmp_*
logs/
reports/

# Temp-file droppings at the repo root: tests (and pytest's basetemp) create 0-byte
# `tmpXXXXXXXX` files when the shell's TMPDIR resolves to the working directory.
# Two of those got committed once (§23.115 added pytest-of-*; this closes the rest).
tmp*
